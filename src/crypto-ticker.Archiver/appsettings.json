{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "KafkaConfiguration": {
    "ClientId":"crypto-ticker.archiver",
    "NumPartitions": 3,
    "ReplicationFactor": 1,
    "Brokers": "localhost:9092",
    "Topics":["aggTrade", "kline_5m"],
    "ConsumerGroup": "trades-cg"
  },
  "CompactorConfiguration":{
    "TaskDelayMinutes": 10,
    "Symbols":["BTCUSDT", "ETHUSDT","SOLUSDT"],
    "CutoffMinutesFromNow": 5,
    "MaxSizeMb": 32
  },
  "ArchiverConfiguration":{
    "MaxBatch": 100000,
    "MaxAgeMinutes": 1
  },
  "S3StorageOptions":{
    "Endpoint":"http://localhost:9000",
    "Region":"ap-southeast-1",
    "UseInstanceProfile": true
  }
}
