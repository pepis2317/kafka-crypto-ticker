{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "KafkaConfiguration": {
    "ClientId":"crypto-ticker.archiver",
    "NumPartitions": 3,
    "ReplicationFactor": 1,
    "Brokers": "localhost:9092",
    "Topics":["aggTrade", "kline"],
    "ConsumerGroup": "trades-cg"
  },
  "S3StorageOptions":{
    "Endpoint":"http://localhost:9000",
    "Region":"ap-southeast-1",
    "UseInstanceProfile": true
  }
}
