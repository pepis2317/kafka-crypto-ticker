{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "KafkaConfiguration": {
    "ClientId":"crypto-ticker.archiver",
    "NumPartitions": 3,
    "ReplicationFactor": 1,
    "Brokers": "localhost:9092",
    "Topics":["aggTrade"],
    "ConsumerGroup": "trades-cg"
  },
  "ArchiverConfiguration":{
    "MaxBatch": 100000,
    "MaxAgeMinutes": 1
  },
  "ClickHouseDbConfiguration":{
    "Host":"localhost",
    "Database":"aggregate_trade_data",
    "Port":"8123",
    "Protocol": "http"
  }
}
