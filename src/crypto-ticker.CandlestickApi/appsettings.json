{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KafkaConfiguration": {
    "ClientId":"crypto-ticker.archiver",
    "NumPartitions": 3,
    "ReplicationFactor": 1,
    "Brokers": "localhost:9092",
    "Topics":["aggTrade"],
    "ConsumerGroup": "candlestick-api"
  },
  "AllowedHosts": "*",
  "ApiConfiguration":{
    "Symbols":["BTCUSDT","ETHUSDT", "SOLUSDT"],
    "MaxPageSize":1000
  },
  "ClickHouseDbConfiguration":{
    "Host":"localhost",
    "Database":"aggregate_trade_data",
    "Port":"8123",
    "Protocol": "http"
  }
}
