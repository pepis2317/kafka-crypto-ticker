{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "KafkaConfiguration": {
    "ClientId":"crypto-ticker.ingester",
    "NumPartitions": 3,
    "ReplicationFactor": 1,
    "Brokers": "localhost:9092",
    "Topics":["aggTrade", "kline"],
    "ConsumerGroup": "trades-cg"
  },
  "WebSocketConfiguration":{
    "DelayExponent": 2,
    "BaseDelaySeconds": 5,
    "MaxDelaySeconds": 45,
    "BaseEndpoint":"wss://stream.binance.com:9443/ws",
    "Symbols":["btcusdt", "ethusdt","solusdt"],
    "StreamTypes":["trade","aggTrade"]
  }
}
